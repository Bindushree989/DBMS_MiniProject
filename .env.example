# ---- MySQL -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# NOTE: db/*.sql create and use a database literally named "back2you"
DB_NAME=back2you
# account used by db:reset / db:seed / test (needs CREATE/DROP DATABASE + CREATE USER)
DB_USER=root
DB_PASSWORD=change_me_root_password
# least-privilege account created by db:reset; the web app uses it when set
DB_APP_USER=b2y_app
DB_APP_PASSWORD=change_me_app_password

# ---- Auth --------------------------------------------------------------
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Vector search (optional: without Qdrant, matching falls back to MySQL full-text) ----
# auto = try Xenova/all-MiniLM-L6-v2 (Transformers.js), fall back to the offline hash embedder
EMBEDDING_PROVIDER=auto
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=found_items
MATCH_ALPHA=0.5
